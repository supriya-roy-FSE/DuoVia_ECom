{
  "name": "duovia-ecom",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node -e \"const fs=require('fs');const s='dist/DuoVia_ECom/browser/index.csr.html';const d='dist/DuoVia_ECom/browser/index.html';if(fs.existsSync(s)){fs.copyFileSync(s,d);}\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "ng build --base-href /DuoVia_ECom/ && npx angular-cli-ghpages --dir=dist/DuoVia_ECom/browser"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/ssr": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-server": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@types/express": "^5.0.3",
    "@types/node": "^20.17.19",
    "angular-cli-ghpages": "^3.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
